function showAppContextMenu(e, app, folderId, winId) {
  e.preventDefault();
  e.stopPropagation();
  const inFolder = !!folderId;
  const pinned = isPinned(app);
  ctxMenu.innerHTML = `
    ${pinned
      ? '<div class="ctx-item danger" id="ctxUnpin">Unpin from taskbar</div>'
      : '<div class="ctx-item" id="ctxPin">Pin to taskbar</div>'}
    <div class="ctx-sep"></div>
    ${inFolder ? '<div class="ctx-item" id="ctxRemoveFromFolder">Remove from folder</div><div class="ctx-sep"></div>' : ''}
    <div class="ctx-item danger" id="ctxUninstall">Remove from desktop</div>
  `;
  ctxMenu.querySelector(pinned ? "#ctxUnpin" : "#ctxPin").onclick = () => {
    if (pinned) unpinFromTaskbar(app); else pinToTaskbar(app);
    closeCtxMenu();
  };
  if (inFolder) {
    ctxMenu.querySelector("#ctxRemoveFromFolder").onclick = () => {
      const list = getFolders();
      const f = list.find(x => x.id === folderId);
      if (f) { f.items = f.items.filter(k => k !== appKey(app)); setFolders(list); }
      renderIcons();
      if (winId) renderFolderBody(winId, folderId);
      closeCtxMenu();
    };
  }
  ctxMenu.querySelector("#ctxUninstall").onclick = () => {
    uninstallApp(app);
    if (winId) renderFolderBody(winId, folderId);
    closeCtxMenu();
  };
  positionCtx(e);
}

function showFolderContextMenu(e, folderId) {
  e.preventDefault();
  e.stopPropagation();
  const folder = getFolders().find(f => f.id === folderId);
  if (!folder) return;
  const colors = ["green","blue","amber","rose","violet","cyan","lime","orange","red"];
  ctxMenu.innerHTML = `
    <div class="ctx-sub">Rename</div>
    <div style="padding:2px 10px 8px;">
      <input type="text" class="ctx-rename-input" id="ctxRenameInput" value="${escapeHtml(folder.name)}">
    </div>
    <div class="ctx-sub">Color</div>
    <div class="ctx-swatches" id="colorRow">
      ${colors.map(c => `<div class="ctx-swatch icon-glyph ${c} ${c===folder.color?'active':''}" data-color="${c}"></div>`).join("")}
    </div>
    <div class="ctx-sep"></div>
    <div class="ctx-item danger" id="ctxDeleteFolder">Delete folder</div>
  `;
  const input = ctxMenu.querySelector("#ctxRenameInput");
  input.addEventListener("keydown", (ev) => {
    if (ev.key === "Enter") { updateFolder(folderId, { name: input.value.trim() || "New Folder" }); closeCtxMenu(); }
  });
  input.addEventListener("blur", () => {
    updateFolder(folderId, { name: input.value.trim() || "New Folder" });
  });
  ctxMenu.querySelectorAll("#colorRow .ctx-swatch").forEach(el => {
    el.onclick = () => { updateFolder(folderId, { color: el.dataset.color }); closeCtxMenu(); };
  });
  ctxMenu.querySelector("#ctxDeleteFolder").onclick = () => {
    if (confirm(`Delete folder "${folder.name}"? Apps inside will return to the desktop.`)) {
      deleteFolder(folderId);
    }
    closeCtxMenu();
  };
  positionCtx(e);
  input.focus();
  input.select();
}

