  .ctx-item:hover { background: rgba(255,255,255,0.07); }
  .ctx-item.danger:hover { background: rgba(239,68,68,0.15); color: #f87171; }
  .ctx-sep { height: 1px; background: var(--border); margin: 5px 4px; }
  .ctx-sub {
