// ===================== START MENU =====================
const startMenu = document.getElementById("start-menu");
const startBtnEl = document.getElementById("start-btn");
const startSearchEl = document.getElementById("startSearch");

startBtnEl.onclick = (e) => {
  e.stopPropagation();
  startMenu.classList.toggle("open");
  if (startMenu.classList.contains("open")) {
    startSearchEl.value = "";
    startSearchEl.focus();
    renderStartList("");
  }
};
document.addEventListener("click", (e) => {
  if (!startMenu.contains(e.target) && e.target !== startBtnEl && !startBtnEl.contains(e.target)) {
    startMenu.classList.remove("open");
  }
});
startSearchEl.addEventListener("input", () => renderStartList(startSearchEl.value));

function renderStartList(query) {
  const q = query.toLowerCase().trim();
  const wrap = document.getElementById("startList");

  const appEntries = allApps
    .filter(a => !q || a.name.toLowerCase().includes(q))
    .map(a => ({ type: "app", data: a }));
  const folderEntries = getFolders()
    .filter(f => !q || f.name.toLowerCase().includes(q))
    .map(f => ({ type: "folder", data: f }));
  const entries = [...folderEntries, ...appEntries];

  if (!entries.length) {
    wrap.innerHTML = '<div style="padding:20px;text-align:center;color:var(--fg-dim);font-size:13px;">No results</div>';
    return;
  }
  wrap.innerHTML = "";
  entries.forEach(entry => {
    const el = document.createElement("div");
    el.className = "start-item";
    if (entry.type === "folder") {
      el.innerHTML = `
        <div class="start-item-icon icon-glyph ${entry.data.color || 'amber'}">📁</div>
        <div class="start-item-text">
          <div class="start-item-name">${escapeHtml(entry.data.name)}</div>
          <div class="start-item-desc">Folder</div>
        </div>
      `;
      el.onclick = () => { openFolder(entry.data.id); startMenu.classList.remove("open"); };
      el.oncontextmenu = (e) => { e.preventDefault(); e.stopPropagation(); showFolderContextMenu(e, entry.data.id); };
    } else {
      const a = entry.data;
      el.innerHTML = `
        <div class="start-item-icon icon-glyph ${a.color || 'green'}">${escapeHtml(a.icon || initials(a.name))}</div>
        <div class="start-item-text">
          <div class="start-item-name">${escapeHtml(a.name)}</div>
          <div class="start-item-desc">${escapeHtml(a.desc || "")}</div>
        </div>
      `;
      el.onclick = () => { launchApp(a); startMenu.classList.remove("open"); };
      el.oncontextmenu = (e) => { e.preventDefault(); e.stopPropagation(); showAppContextMenu(e, a); };
    }
    wrap.appendChild(el);
  });
}

// ===================== WINDOW MANAGER =====================
const desktop = document.getElementById("desktop");
const tasklist = document.getElementById("tasklist");
let winCount = 0;
const openWindows = new Map(); // id -> {el, taskEl, app}

function launchApp(app) {
  // non-raw links just open in a new tab, same behavior as VUS Hub
  if (!app.url.includes("raw.githubusercontent.com")) {
    window.open(app.url, "_blank", "noopener");
    return;
  }
  // if this app is pinned to the taskbar, route through the pinned launcher
  // so the pinned tile picks up the "active/running" state correctly
  if (isPinned(app)) { launchPinnedApp(app); return; }
  const id = "win" + (++winCount);
  const win = createWindow(id, app);
  desktop.appendChild(win);
  createTaskItem(id, app);
  focusWindow(id);
  loadAppContent(id, app);
}

// ===================== APP STORE WINDOW =====================
let storeWinId = null;

function openAppStore() {
  // if already open, toggle minimize/focus like clicking its taskbar tile
  if (storeWinId && document.getElementById(storeWinId)) {
    const win = document.getElementById(storeWinId);
    if (win.classList.contains("minimized")) {
      win.classList.remove("minimized");
      focusWindow(storeWinId);
    } else if (parseInt(win.style.zIndex) === zTop) {
      minimizeWindow(storeWinId);
    } else {
      focusWindow(storeWinId);
    }
    return;
  }
  const id = "win" + (++winCount);
  storeWinId = id;
  const win = createWindow(id, STORE_APP, true);
  desktop.appendChild(win);
  openWindows.set(id, { taskEl: null, app: STORE_APP });
  focusWindow(id);
  renderStoreBody(id);
}

function renderStoreBody(id) {
  const win = document.getElementById(id);
  const body = win.querySelector(".win-body");
  body.innerHTML = `
    <div class="store-wrap">
      <div class="store-header">
        <h2>App Store</h2>
        <input type="text" class="store-search" id="storeSearch-${id}" placeholder="Search apps..." autocomplete="off">
        <div class="store-tabs" id="storeTabs-${id}"></div>
      </div>
      <div class="store-list" id="storeList-${id}"></div>
    </div>
  `;
  const listEl = body.querySelector("#storeList-" + id);
  const searchEl = body.querySelector("#storeSearch-" + id);
  const tabsEl = body.querySelector("#storeTabs-" + id);

  const TABS = [
    { key: "all", label: "All" },
    { key: "apps", label: "Apps" },
    { key: "hubs", label: "Hubs" },
    { key: "tools", label: "Tools" },
    { key: "links", label: "Links" }
  ];
  let activeTab = "all";

  function drawTabs() {
    tabsEl.innerHTML = "";
    TABS.forEach(t => {
      const el = document.createElement("div");
      el.className = "store-tab" + (t.key === activeTab ? " active" : "");
      el.textContent = t.label;
      el.onclick = () => { activeTab = t.key; drawTabs(); draw(); };
      tabsEl.appendChild(el);
    });
  }

  function draw() {
    const q = searchEl.value.toLowerCase().trim();
    let items = activeTab === "all" ? allApps : allApps.filter(a => a.category === activeTab);
    if (q) items = items.filter(a => a.name.toLowerCase().includes(q));
    if (!items.length) {
      listEl.innerHTML = '<div class="store-empty">No apps found</div>';
      return;
    }
    listEl.innerHTML = "";
    items.forEach(app => {
      const installed = isInstalled(app);
      const card = document.createElement("div");
      card.className = "store-card";
      card.innerHTML = `
        <div class="store-card-top">
          <div class="store-card-icon icon-glyph ${app.color || 'green'}">${escapeHtml(app.icon || initials(app.name))}</div>
          <div class="store-card-name">${escapeHtml(app.name)}</div>
        </div>
        <div class="store-card-desc">${escapeHtml(app.desc || "")}</div>
        <button class="store-card-btn ${installed ? 'installed' : ''}">${installed ? 'Installed ✓' : 'Install'}</button>
      `;
      const btn = card.querySelector(".store-card-btn");
      btn.onclick = () => {
        if (isInstalled(app)) {
          uninstallApp(app);
          draw();
        } else {
          btn.disabled = true;
          btn.textContent = "Installing...";
          const delay = 500 + Math.random() * 1500;
          setTimeout(() => {
            installApp(app);
            draw();
          }, delay);
        }
      };
      card.oncontextmenu = (e) => { e.preventDefault(); showAppContextMenu(e, app); };
      listEl.appendChild(card);
    });
  }
  searchEl.addEventListener("input", draw);
  drawTabs();
  draw();
}

