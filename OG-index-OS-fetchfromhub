<body>

<!-- BOOT SCREEN -->
<div id="boot">
  <div class="boot-logo">V</div>
  <div class="boot-title" id="bootTitle">VUS-OS</div>
  <div class="boot-bar-track"><div class="boot-bar-fill" id="bootFill"></div></div>
</div>

<!-- DESKTOP -->
<div id="desktop">
  <div id="grid-overlay"></div>
  <div id="icons"></div>
  <!-- windows get appended here -->
</div>

<!-- START MENU -->
<div id="start-menu">
  <div class="start-search">
    <input type="text" id="startSearch" placeholder="Search apps and folders..." autocomplete="off">
  </div>
  <div class="start-list" id="startList"></div>
</div>

<!-- CONTEXT MENU -->
<div class="ctx-menu" id="ctxMenu"></div>

<!-- TASKBAR -->
<div id="taskbar">
  <button id="start-btn">
    <span class="mark">V</span>
    <span id="startBtnLabel">Start</span>
  </button>
  <div id="taskbar-sep"></div>
  <div id="system-tiles"></div>
  <div id="taskbar-sep"></div>
  <div id="tasklist"></div>
  <div id="clock">
    <div class="time" id="clockTime">--:--</div>
    <div class="date" id="clockDate">--</div>
  </div>
</div>

<script>
// ===================== CONFIG =====================
const APPS_JSON_URL = "https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/apps.json";

// ===================== SITE NAME (localStorage) =====================
const SITE_NAME_KEY = "vusos_site_name";
const DEFAULT_SITE_NAME = "VUS-OS";
function getSiteName() {
  return localStorage.getItem(SITE_NAME_KEY) || DEFAULT_SITE_NAME;
}
function setSiteName(name) {
  const clean = (name || "").trim();
  const final = clean || DEFAULT_SITE_NAME;
  localStorage.setItem(SITE_NAME_KEY, final);
  applySiteName();
}
function applySiteName() {
  const name = getSiteName();
  document.title = name;
  const bootTitle = document.getElementById("bootTitle");
  if (bootTitle) bootTitle.textContent = name;
}
applySiteName();

// ===================== BACKGROUND (localStorage) =====================
// { mode: "default" | "color" | "image" | "link", color, image (dataURL), link }
const BG_KEY = "vusos_background";
function getBackground() {
  try { return Object.assign({ mode: "default", color: "#0a0e1a", image: "", link: "" }, JSON.parse(localStorage.getItem(BG_KEY))); }
  catch { return { mode: "default", color: "#0a0e1a", image: "", link: "" }; }
}
function setBackground(patch) {
  const bg = Object.assign(getBackground(), patch);
  try {
    localStorage.setItem(BG_KEY, JSON.stringify(bg));
  } catch (e) {
    // likely quota exceeded from a large image — surface via alert as a fallback
    alert("Could not save background — the image may be too large for storage.");
    return;
  }
  applyBackground();
}
function applyBackground() {
  const bg = getBackground();
  const desktopEl = document.getElementById("desktop");
  const defaultGradient =
    "radial-gradient(circle at 15% 15%, rgba(34,197,94,0.10), transparent 45%), " +
    "radial-gradient(circle at 85% 80%, rgba(16,185,129,0.08), transparent 45%)";
  if (bg.mode === "color" && bg.color) {
    desktopEl.style.background = bg.color;
  } else if (bg.mode === "image" && bg.image) {
    desktopEl.style.background = `url("${bg.image}") center / cover no-repeat, var(--bg)`;
  } else if (bg.mode === "link" && bg.link) {
    desktopEl.style.background = `url("${bg.link}") center / cover no-repeat, var(--bg)`;
  } else {
    desktopEl.style.background = `${defaultGradient}, var(--bg)`;
  }
}
applyBackground();

// ===================== BOOT SEQUENCE =====================
window.addEventListener("load", () => {
  const fill = document.getElementById("bootFill");
  // force reflow so the transition actually animates from 0
  requestAnimationFrame(() => {
    requestAnimationFrame(() => { fill.style.width = "100%"; });
  });
  setTimeout(() => {
    document.getElementById("boot").classList.add("hide");
    setTimeout(() => document.getElementById("boot").remove(), 550);
  }, 2000);
});

// ===================== UTIL =====================
function escapeHtml(str) {
  return (str || "").replace(/[&<>"']/g, c => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  }[c]));
}
function initials(name) {
  return (name || "?").trim().substring(0, 2).toUpperCase();
}
let zTop = 10;
const appKey = app => app.name + "|" + app.url;

// ===================== BUILT-IN APPS =====================
// Always-on desktop apps. VUS Launcher pulled live from apps.json's "home"
// entry once loaded; Notes points at the VUS Hub Notes tool; Store is local.
const STORE_APP = { name: "App Store", url: "__store__", desc: "Browse and install VUS apps", icon: "🛒", color: "violet" };
const SETTINGS_APP = { name: "Settings", url: "__settings__", desc: "VUS-OS preferences", icon: "⚙️", color: "cyan" };
let launcherApp = { name: "VUS Launcher", url: "https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/main/VUSL", desc: "Main game hub", icon: "🎮", color: "green" };
let notesApp = { name: "Notes", url: "https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/Notes", desc: "Keep text saved easily", icon: "📝", color: "amber" };

// ===================== INSTALLED STATE (localStorage) =====================
const LS_KEY = "vusos_installed";
const LS_SEEDED_KEY = "vusos_seeded";
function getInstalled() {
  try { return JSON.parse(localStorage.getItem(LS_KEY)) || []; }
  catch { return []; }
}
function setInstalled(list) {
  localStorage.setItem(LS_KEY, JSON.stringify(list));
}
function isInstalled(app) {
  return getInstalled().some(a => appKey(a) === appKey(app));
}
function installApp(app) {
  const list = getInstalled();
  if (!list.some(a => appKey(a) === appKey(app))) {
    list.push(app);
    setInstalled(list);
    placeNewItemAtFreeCell(appKey(app));
  }
  renderIcons();
}
function uninstallApp(app) {
  setInstalled(getInstalled().filter(a => appKey(a) !== appKey(app)));
  removeFromAllFolders(appKey(app));
  const positions = getPositions();
  delete positions[appKey(app)];
  localStorage.setItem(POS_KEY, JSON.stringify(positions));
  renderIcons();
}
// On first-ever run, seed VUS Launcher + Notes into "installed" so they behave
// exactly like any other app the user could remove/reinstall via the Store.
function seedDefaultsIfNeeded() {
  if (localStorage.getItem(LS_SEEDED_KEY)) return;
  const list = getInstalled();
  [launcherApp, notesApp].forEach(app => {
    if (!list.some(a => appKey(a) === appKey(app))) list.push(app);
  });
  setInstalled(list);
  localStorage.setItem(LS_SEEDED_KEY, "1");
}

// ===================== FOLDERS (localStorage) =====================
// folder = { id, name, color, items: [appKey,...] }  (items can also reference other folder ids, prefixed "folder:")
const FOLDERS_KEY = "vusos_folders";
function getFolders() {
  try { return JSON.parse(localStorage.getItem(FOLDERS_KEY)) || []; }
  catch { return []; }
}
function setFolders(list) { localStorage.setItem(FOLDERS_KEY, JSON.stringify(list)); }
function createFolder() {
  const list = getFolders();
  const id = "folder_" + Date.now();
  list.push({ id, name: "New Folder", color: "amber", items: [] });
  setFolders(list);
  placeNewItemAtFreeCell("folder:" + id);
  renderIcons();
}
function updateFolder(id, patch) {
  const list = getFolders();
  const f = list.find(x => x.id === id);
  if (f) Object.assign(f, patch);
  setFolders(list);
  renderIcons();
}
function deleteFolder(id) {
  setFolders(getFolders().filter(x => x.id !== id));
  renderIcons();
}
function removeFromAllFolders(itemKey) {
  const list = getFolders();
  list.forEach(f => { f.items = f.items.filter(k => k !== itemKey); });
  setFolders(list);
}
function findAppByKey(key) {
  if (key.startsWith("folder:")) return null;
  return allApps.find(a => appKey(a) === key) ||
    getInstalled().find(a => appKey(a) === key) ||
    [launcherApp, notesApp].find(a => appKey(a) === key) || null;
}

// ===================== ICON SIZE (localStorage) =====================
const SIZE_KEY = "vusos_icon_size";
const ICON_SIZES = { small: 96, medium: 128, large: 160 };
function getIconSize() { return localStorage.getItem(SIZE_KEY) || "medium"; }
function setIconSize(size) { localStorage.setItem(SIZE_KEY, size); applyIconSize(); refreshDesktopIcons(); }
function applyIconSize() {
  const px = ICON_SIZES[getIconSize()] || 96;
  document.documentElement.style.setProperty("--icon-cell", px + "px");
  document.documentElement.style.setProperty("--icon-cell-h", (px + 4) + "px");
  // scale the glyph square + its font proportionally to the cell size
  const glyph = Math.round(px * 0.44);
  const glyphFont = Math.round(px * 0.18);
  document.documentElement.style.setProperty("--icon-glyph", glyph + "px");
  document.documentElement.style.setProperty("--icon-glyph-font", glyphFont + "px");
}

// ===================== GENERAL SETTINGS (localStorage) =====================
const SETTINGS_KEY = "vusos_settings";
function getSettings() {
  try { return Object.assign({ clickMode: "single", snapMode: "snap" }, JSON.parse(localStorage.getItem(SETTINGS_KEY))); }
  catch { return { clickMode: "single", snapMode: "snap" }; }
}
function setSetting(key, val) {
  const s = getSettings();
  s[key] = val;
  localStorage.setItem(SETTINGS_KEY, JSON.stringify(s));
}

// ===================== ICON POSITIONS (localStorage) =====================
const POS_KEY = "vusos_positions";
function getPositions() {
  try { return JSON.parse(localStorage.getItem(POS_KEY)) || {}; }
  catch { return {}; }
}
function setPosition(itemKey, x, y) {
  const pos = getPositions();
  pos[itemKey] = { x, y };
  localStorage.setItem(POS_KEY, JSON.stringify(pos));
}
function cellPx() { return ICON_SIZES[getIconSize()] || 96; }
function snapCoord(px, cell) { return Math.round(px / cell) * cell; }

// ===================== GRID HELPERS =====================
// Column/row spacing matches what renderIcons()'s auto-placement used to use.
function gridStep() {
  const cell = cellPx();
  return { colStep: cell + 2, rowStep: cell + 4 };
}
// Convert a pixel position to the nearest valid (col,row) grid cell, clamped
// so the icon can never sit off-screen on any edge.
function pxToCell(x, y) {
  const { colStep, rowStep } = gridStep();
  const cols = Math.max(1, Math.floor((desktop.clientWidth - 14) / colStep));
  const rows = Math.max(1, Math.floor((desktop.clientHeight - 28) / rowStep));
  let col = Math.round((x - 14) / colStep);
  let row = Math.round((y - 14) / rowStep);
  col = Math.min(Math.max(col, 0), cols - 1);
  row = Math.min(Math.max(row, 0), rows - 1);
  return { col, row };
}
function cellToPx(col, row) {
  const { colStep, rowStep } = gridStep();
  return { x: 14 + col * colStep, y: 14 + row * rowStep };
}
// Clamp an arbitrary pixel position so the full icon box stays on screen —
// strict against the top and left edges (never negative), and also capped
// against the right/bottom edges using the current icon cell size.
function clampToDesktop(x, y) {
  const cell = cellPx();
  const cellH = cell + 4;
  const maxX = Math.max(0, desktop.clientWidth - cell);
  const maxY = Math.max(0, desktop.clientHeight - cellH);
  return {
    x: Math.min(Math.max(x, 0), maxX),
    y: Math.min(Math.max(y, 0), maxY)
  };
}

// Returns the set of grid cells (as "c,r" strings) currently occupied by
// EVERY existing desktop item's persisted position, excluding `excludeKey`.
// Unlike iconKeyAtCell (which reads the live DOM and therefore only works
// after a render has happened), this reads straight from localStorage plus
// the known auto-placement fallback, so it's safe to call before a new
// item has ever been rendered.
function occupiedCellsExcluding(excludeKey) {
  const folders = getFolders();
  const desktopApps = [...getInstalled()];
  const allKeys = [...desktopApps.map(a => appKey(a)), ...folders.map(f => "folder:" + f.id)];
  const positions = getPositions();
  const occupied = new Set();
  const cell = cellPx();
  let autoIndex = 0;
  const perCol = Math.max(1, Math.floor((desktop.clientHeight - 28) / (cell + 4)));
  allKeys.forEach(key => {
    if (key === excludeKey) return;
    let px;
    if (positions[key]) {
      px = positions[key];
    } else {
      // mirrors nextAutoPos() in renderIcons()
      const col = Math.floor(autoIndex / perCol);
      const row = autoIndex % perCol;
      autoIndex++;
      px = { x: 14 + col * (cell + 2), y: 14 + row * (cell + 4) };
    }
    const { col, row } = pxToCell(px.x, px.y);
    occupied.add(col + "," + row);
  });
  return occupied;
}

// Finds the nearest free grid cell to the top-left (0,0) origin — used to
// place a brand-new item (freshly installed app, newly created folder) onto
// the desktop without overlapping anything already there.
function placeNewItemAtFreeCell(key) {
  const occupied = occupiedCellsExcluding(key);
  const { colStep, rowStep } = gridStep();
  const cols = Math.max(1, Math.floor((desktop.clientWidth - 14) / colStep));
  const rows = Math.max(1, Math.floor((desktop.clientHeight - 28) / rowStep));
  // scan column-major (matches the visual fill order of nextAutoPos）
  for (let c = 0; c < cols; c++) {
    for (let r = 0; r < rows; r++) {
      const k = c + "," + r;
      if (!occupied.has(k)) {
        const { x, y } = cellToPx(c, r);
        setPosition(key, x, y);
        return;
      }
    }
  }
  // grid is completely full — fall back to (0,0), it'll just overlap
  const { x, y } = cellToPx(0, 0);
  setPosition(key, x, y);
}

// ===================== LOAD APPS.JSON =====================
let allApps = [];

fetch(APPS_JSON_URL)
  .then(r => r.json())
  .then(data => {
    // "home" (the launcher tile) is folded into the "apps" category for
    // store/filter purposes — it's still just an app to the user.
    const sectionToCategory = { home: "apps", apps: "apps", tools: "tools", hubs: "hubs", links: "links" };
    const seen = new Set();
    Object.keys(sectionToCategory).forEach(sec => {
      (data[sec] || []).forEach(app => {
        if (!app.name || !app.url) return;
        const key = app.name + "|" + app.url;
        if (seen.has(key)) return;
        seen.add(key);
        allApps.push(Object.assign({}, app, { category: sectionToCategory[sec] }));
      });
    });
    // prefer live data for the built-in launcher/notes if present
    const liveLauncher = allApps.find(a => a.name === "VUS Launcher");
    const liveNotes = allApps.find(a => a.name === "Notes");
    if (liveLauncher) launcherApp = liveLauncher;
    if (liveNotes) notesApp = liveNotes;

    seedDefaultsIfNeeded();
    renderIcons();
    renderPinnedTaskbar();
    // Auto plain-refresh once, on first load, so icons always start in
    // correct grid spots with no overlaps and nothing off-screen.
    refreshDesktopIcons();
  })
  .catch(err => {
    console.error("Failed to load apps.json", err);
    seedDefaultsIfNeeded();
    renderIcons(); // still show built-ins even if apps.json fails
    renderPinnedTaskbar();
    refreshDesktopIcons();
  });

// ===================== DESKTOP ICONS =====================
const gridOverlay = document.getElementById("grid-overlay");

function itemIdentityKey(app, folder) {
  return folder ? "folder:" + folder.id : appKey(app);
}

function renderIcons() {
  applyIconSize();
  const wrap = document.getElementById("icons");
  wrap.innerHTML = "";

  const folders = getFolders();
  const desktopApps = [...getInstalled()];
  const positions = getPositions();
  const cell = cellPx();

  let autoIndex = 0;
  function nextAutoPos() {
    const perCol = Math.max(1, Math.floor((desktop.clientHeight - 28) / (cell + 4)));
    const col = Math.floor(autoIndex / perCol);
    const row = autoIndex % perCol;
    autoIndex++;
    return { x: 14 + col * (cell + 2), y: 14 + row * (cell + 4) };
  }

  function place(el, key) {
    const pos = positions[key] || nextAutoPos();
    el.style.left = pos.x + "px";
    el.style.top = pos.y + "px";
  }

  desktopApps.forEach(app => {
    const el = buildAppIcon(app);
    place(el, appKey(app));
    wrap.appendChild(el);
  });
  folders.forEach(f => {
    const el = buildFolderIcon(f);
    place(el, "folder:" + f.id);
    wrap.appendChild(el);
  });
}

// ===================== REFRESH =====================
// Plain grid refresh: snap every existing desktop item to the nearest valid
// grid cell (never off-screen), resolve overlaps by walking the grid in
// order and assigning each item the next free cell, and drop position
// records for items that no longer exist. This does NOT reshuffle items
// into a totally fresh layout — each item stays as close as possible to
// its current spot, just corrected onto the grid / into view / de-overlapped.
function refreshDesktopIcons() {
  const folders = getFolders();
  const desktopApps = [...getInstalled()];
  const validKeys = new Set([
    ...desktopApps.map(a => appKey(a)),
    ...folders.map(f => "folder:" + f.id)
  ]);

  const positions = getPositions();
  // drop stale entries (apps that were uninstalled / folders deleted)
  Object.keys(positions).forEach(k => {
    if (!validKeys.has(k)) delete positions[k];
  });

  const { colStep, rowStep } = gridStep();
  const cols = Math.max(1, Math.floor((desktop.clientWidth - 14) / colStep));
  const rows = Math.max(1, Math.floor((desktop.clientHeight - 28) / rowStep));
  const occupied = new Set();
  const cellKey = (c, r) => c + "," + r;

  function nearestFreeCell(wantCol, wantRow) {
    // BFS outward from the wanted cell for the closest unoccupied, in-bounds cell
    const seen = new Set();
    const queue = [{ c: wantCol, r: wantRow, d: 0 }];
    seen.add(cellKey(wantCol, wantRow));
    while (queue.length) {
      const { c, r } = queue.shift();
      if (c >= 0 && c < cols && r >= 0 && r < rows && !occupied.has(cellKey(c, r))) {
        return { c, r };
      }
      [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dc, dr]) => {
        const nc = c + dc, nr = r + dr;
        const k = cellKey(nc, nr);
        if (!seen.has(k)) { seen.add(k); queue.push({ c: nc, r: nr }); }
      });
      // safety cap
      if (seen.size > (cols * rows + 50)) break;
    }
    // fallback: first free cell scanning row-major
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        if (!occupied.has(cellKey(c, r))) return { c, r };
      }
    }
    return { c: 0, r: 0 };
  }

  // Process items ordered by their current position (top-to-bottom,
  // left-to-right) so placement order feels stable and predictable.
  const allKeys = [...desktopApps.map(a => appKey(a)), ...folders.map(f => "folder:" + f.id)];
  const withPos = allKeys.map(key => {
    const pos = positions[key];
    if (pos) {
      const { col, row } = pxToCell(pos.x, pos.y);
      return { key, col, row, hadPos: true };
    }
    return { key, col: 0, row: 0, hadPos: false };
  });
  withPos.sort((a, b) => (a.row - b.row) || (a.col - b.col));

  withPos.forEach(item => {
    const free = nearestFreeCell(item.col, item.row);
    occupied.add(cellKey(free.c, free.r));
    const { x, y } = cellToPx(free.c, free.r);
    positions[item.key] = { x, y };
  });

  localStorage.setItem(POS_KEY, JSON.stringify(positions));
  renderIcons();
}

// ===================== SORT =====================
// Fully repacks every desktop item into the grid, column-major (fills a
// column top-to-bottom, then moves to the next column — matching how
// nextAutoPos() in renderIcons() lays things out), in the order determined
// by `mode`:
//   "alpha"    - alphabetical by name (folders + apps together, A→Z)
//   "leftright"- by current position, left-to-right then top-to-bottom
//   "topbottom"- by current position, top-to-bottom then left-to-right
function sortDesktopIcons(mode) {
  const folders = getFolders();
  const desktopApps = [...getInstalled()];
  const positions = getPositions();

  const items = [
    ...desktopApps.map(a => ({ key: appKey(a), name: a.name })),
    ...folders.map(f => ({ key: "folder:" + f.id, name: f.name }))
  ].map(item => {
    const pos = positions[item.key];
    const cell = pos ? pxToCell(pos.x, pos.y) : { col: 0, row: 0 };
    return { ...item, col: cell.col, row: cell.row };
  });

  if (mode === "alpha") {
    items.sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: "base" }));
  } else if (mode === "topbottom") {
    items.sort((a, b) => (a.row - b.row) || (a.col - b.col) || a.name.localeCompare(b.name));
  } else { // "leftright" (default)
    items.sort((a, b) => (a.col - b.col) || (a.row - b.row) || a.name.localeCompare(b.name));
  }

  const { colStep, rowStep } = gridStep();
  const rows = Math.max(1, Math.floor((desktop.clientHeight - 28) / rowStep));
  const cols = Math.max(1, Math.floor((desktop.clientWidth - 14) / colStep));

  items.forEach((item, i) => {
    let col, row;
    if (mode === "topbottom") {
      // row-major: fill the top row left-to-right, then wrap to the next row
      col = i % cols;
      row = Math.floor(i / cols);
    } else {
      // column-major: fill the left column top-to-bottom, then wrap to the next column
      col = Math.floor(i / rows);
      row = i % rows;
    }
    positions[item.key] = { x: 14 + col * colStep, y: 14 + row * rowStep };
  });

  localStorage.setItem(POS_KEY, JSON.stringify(positions));
  renderIcons();
}

// isLocked: cannot be removed from the desktop, and cannot be dropped into a folder.
// (App Store and Settings no longer live on the desktop at all — they're
// permanent system tiles in the taskbar — so nothing on the desktop is locked.)
function isLocked(app) {
  return false;
}
// isFoldable: whether this icon can be dragged into a folder. The two
// default built-ins (Launcher/Notes) stay desktop-only.
function isFoldable(app) {
  return app !== launcherApp && app !== notesApp;
}

function buildAppIcon(app) {
  const el = document.createElement("div");
  el.className = "icon";
  el.dataset.key = appKey(app);
  el.innerHTML = `
    <div class="icon-glyph ${app.color || 'green'}">${escapeHtml(app.icon || initials(app.name))}</div>
    <div class="icon-label">${escapeHtml(app.name)}</div>
  `;
  const open = () => {
    if (app.url === "__store__") openAppStore();
    else if (app.url === "__settings__") openSettings();
    else launchApp(app);
  };

  if (!isLocked(app)) {
    el.oncontextmenu = (e) => { e.preventDefault(); showAppContextMenu(e, app); };
  }

  wireIconInteraction(el, appKey(app), isLocked(app), isFoldable(app), open);
  return el;
}

function buildFolderIcon(folder) {
  const el = document.createElement("div");
  el.className = "icon";
  el.dataset.folderId = folder.id;
  el.innerHTML = `
    <div class="icon-glyph ${folder.color || 'amber'}">📁</div>
    <div class="icon-label">${escapeHtml(folder.name)}</div>
  `;
  const open = () => openFolder(folder.id);
  el.oncontextmenu = (e) => { e.preventDefault(); showFolderContextMenu(e, folder.id); };

  wireIconInteraction(el, "folder:" + folder.id, false, true, open);
  return el;
}

// Wires a desktop icon's click/tap-to-open + drag-to-move/drop-into-folder
// behavior in one place, so a drag never also triggers an open.
function wireIconInteraction(el, key, locked, foldable, open) {
  let lastClickTime = 0;
  const onSimpleClick = () => {
    selectIcon(el);
    const mode = getSettings().clickMode;
    if (mode === "single") {
      open();
    } else {
      // double-click mode: open only if two quick clicks land close in time
      const now = Date.now();
      if (now - lastClickTime < 350) open();
      lastClickTime = now;
    }
  };
  attachDrag(el, key, locked, foldable, onSimpleClick);
}

function selectIcon(el) {
  document.querySelectorAll(".icon.selected").forEach(i => i.classList.remove("selected"));
  el.classList.add("selected");
}

// ===================== MANUAL DRAG (reposition + drop-into-folder + swap) =====================
function attachDrag(el, key, locked, foldable, onSimpleClick) {
  let dragging = false;
  let startX, startY, startLeft, startTop, pressTime;

  el.addEventListener("mousedown", (e) => {
    if (e.button !== 0) return;
    startX = e.clientX; startY = e.clientY;
    startLeft = el.offsetLeft; startTop = el.offsetTop;
    pressTime = Date.now();
    dragging = false;

    function onMove(ev) {
      const dx = ev.clientX - startX, dy = ev.clientY - startY;
      if (!dragging && Math.hypot(dx, dy) > 4) {
        dragging = true;
        el.classList.add("dragging");
        if (getSettings().snapMode === "snap") gridOverlay.classList.add("show");
      }
      if (!dragging) return;
      // Strict bounds while dragging: never allow the icon past the top or
      // left edge, and cap it against the right/bottom edge too.
      const clamped = clampToDesktop(startLeft + dx, startTop + dy);
      el.style.left = clamped.x + "px";
      el.style.top = clamped.y + "px";

      // highlight folder under cursor (only if this item is allowed to be foldered)
      document.querySelectorAll(".icon").forEach(i => { if (i !== el) i.classList.remove("selected"); });
      if (foldable) {
        const under = elementUnderIcon(el, ev);
        if (under && under.dataset.folderId) under.classList.add("selected");
      }
    }

    function onUp(ev) {
      document.removeEventListener("mousemove", onMove);
      document.removeEventListener("mouseup", onUp);
      gridOverlay.classList.remove("show");
      const heldMs = Date.now() - pressTime;

      if (!dragging) {
        el.classList.remove("dragging");
        // treat as a simple click if released quickly and didn't drag
        if (heldMs < 500) onSimpleClick();
        return;
      }

      el.classList.remove("dragging");
      if (foldable) {
        const under = elementUnderIcon(el, ev);
        if (under && under.dataset.folderId && under !== el) {
          moveItemIntoFolder(key, under.dataset.folderId);
          renderIcons();
          return;
        }
      }

      finishIconDrop(el, key, startLeft, startTop);
    }

    document.addEventListener("mousemove", onMove);
    document.addEventListener("mouseup", onUp);
  });

  // touch support (simplified: press-drag)
  el.addEventListener("touchstart", (e) => {
    const touch = e.touches[0];
    startX = touch.clientX; startY = touch.clientY;
    startLeft = el.offsetLeft; startTop = el.offsetTop;
    pressTime = Date.now();
    dragging = false;
  }, { passive: true });
  el.addEventListener("touchmove", (e) => {
    const touch = e.touches[0];
    const dx = touch.clientX - startX, dy = touch.clientY - startY;
    if (!dragging && Math.hypot(dx, dy) > 8) {
      dragging = true;
      el.classList.add("dragging");
      if (getSettings().snapMode === "snap") gridOverlay.classList.add("show");
    }
    if (!dragging) return;
    const clamped = clampToDesktop(startLeft + dx, startTop + dy);
    el.style.left = clamped.x + "px";
    el.style.top = clamped.y + "px";
  }, { passive: true });
  el.addEventListener("touchend", (e) => {
    gridOverlay.classList.remove("show");
    const heldMs = Date.now() - pressTime;
    if (!dragging) {
      el.classList.remove("dragging");
      if (heldMs < 500) onSimpleClick();
      return;
    }
    el.classList.remove("dragging");

    if (foldable) {
      const under = elementUnderIcon(el, e);
      if (under && under.dataset.folderId && under !== el) {
        moveItemIntoFolder(key, under.dataset.folderId);
        renderIcons();
        dragging = false;
        return;
      }
    }

    finishIconDrop(el, key, startLeft, startTop);
    dragging = false;
  }, true);
}

// Returns the storage key (app key or "folder:id") for whichever rendered
// desktop icon is currently sitting in the given (col,row) grid cell,
// excluding `excludeKey`. Reads from the live DOM rather than the positions
// store, since a never-dragged icon may only have an auto-placed position
// that was never persisted to localStorage.
function iconKeyAtCell(col, row, excludeKey) {
  const icons = document.querySelectorAll("#icons > .icon");
  for (const icon of icons) {
    const iconKey = icon.dataset.key || (icon.dataset.folderId ? "folder:" + icon.dataset.folderId : null);
    if (!iconKey || iconKey === excludeKey) continue;
    const pc = pxToCell(icon.offsetLeft, icon.offsetTop);
    if (pc.col === col && pc.row === row) return iconKey;
  }
  return null;
}

// Shared drop logic for mouse + touch: snaps the dropped icon to a grid
// cell. If another item already occupies that cell, swap the two items'
// positions (the occupant takes the spot this icon was dragged from). If
// for any reason a swap can't be resolved, fall back to placing this icon
// in the closest free cell instead of allowing an overlap.
function finishIconDrop(el, key, startLeft, startTop) {
  const clamped = clampToDesktop(el.offsetLeft, el.offsetTop);
  let x = clamped.x, y = clamped.y;

  if (getSettings().snapMode === "snap") {
    const { col, row } = pxToCell(x, y);
    const target = cellToPx(col, row);
    x = target.x; y = target.y;

    const occupantKey = iconKeyAtCell(col, row, key);

    if (occupantKey && !isKeyLocked(occupantKey)) {
      // swap: the occupant moves to wherever this icon started the drag
      const startClamped = clampToDesktop(
        startLeft !== undefined ? startLeft : el.offsetLeft,
        startTop !== undefined ? startTop : el.offsetTop
      );
      const startCell = pxToCell(startClamped.x, startClamped.y);
      const startPos = cellToPx(startCell.col, startCell.row);

      const positions = getPositions();
      positions[occupantKey] = { x: startPos.x, y: startPos.y };
      positions[key] = { x, y };
      localStorage.setItem(POS_KEY, JSON.stringify(positions));
      renderIcons();
      return;
    }

    if (occupantKey) {
      // occupant can't be moved (e.g. locked) — place this icon in the
      // closest free cell instead of overlapping it
      const free = nearestFreeCellExcluding(col, row, key);
      const freePos = cellToPx(free.c, free.r);
      x = freePos.x; y = freePos.y;
    }
  }

  el.style.left = x + "px";
  el.style.top = y + "px";
  setPosition(key, x, y);
}

// No desktop icons are locked anymore (App Store / Settings moved to the
// taskbar), but this hook is kept in case future built-ins need it.
function isKeyLocked(key) {
  return false;
}

// BFS outward from (wantCol,wantRow) for the nearest in-bounds grid cell
// that isn't occupied by any rendered icon other than `excludeKey`.
function nearestFreeCellExcluding(wantCol, wantRow, excludeKey) {
  const { colStep, rowStep } = gridStep();
  const cols = Math.max(1, Math.floor((desktop.clientWidth - 14) / colStep));
  const rows = Math.max(1, Math.floor((desktop.clientHeight - 28) / rowStep));
  const cellKey = (c, r) => c + "," + r;
  const seen = new Set([cellKey(wantCol, wantRow)]);
  const queue = [{ c: wantCol, r: wantRow }];
  while (queue.length) {
    const { c, r } = queue.shift();
    if (c >= 0 && c < cols && r >= 0 && r < rows && !iconKeyAtCell(c, r, excludeKey)) {
      return { c, r };
    }
    [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dc, dr]) => {
      const nc = c + dc, nr = r + dr;
      const k = cellKey(nc, nr);
      if (!seen.has(k)) { seen.add(k); queue.push({ c: nc, r: nr }); }
    });
    if (seen.size > (cols * rows + 50)) break;
  }
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (!iconKeyAtCell(c, r, excludeKey)) return { c, r };
    }
  }
  return { c: wantCol, r: wantRow };
}

function elementUnderIcon(dragEl, ev) {
  dragEl.style.pointerEvents = "none";
  const clientX = ev.clientX !== undefined ? ev.clientX : (ev.changedTouches && ev.changedTouches[0].clientX);
  const clientY = ev.clientY !== undefined ? ev.clientY : (ev.changedTouches && ev.changedTouches[0].clientY);
  const el = document.elementFromPoint(clientX, clientY);
  dragEl.style.pointerEvents = "";
  return el ? el.closest(".icon") : null;
}

function moveItemIntoFolder(key, folderId) {
  // remove position record so it re-autoplaces if it ever leaves the folder
  const positions = getPositions();
  delete positions[key];
  localStorage.setItem(POS_KEY, JSON.stringify(positions));

  const list = getFolders();
  const target = list.find(f => f.id === folderId);
  if (!target) return;
  if (!target.items.includes(key)) target.items.push(key);
  setFolders(list);
}

// ===================== FOLDER WINDOW =====================
function openFolder(folderId) {
  const folder = getFolders().find(f => f.id === folderId);
  if (!folder) return;
  const id = "win" + (++winCount);
  const pseudoApp = { name: folder.name, icon: "📁", color: folder.color };
  const win = createWindow(id, pseudoApp, true);
  win.dataset.folderId = folderId;
  desktop.appendChild(win);
  createTaskItem(id, pseudoApp);
  focusWindow(id);
  renderFolderBody(id, folderId);
}

function renderFolderBody(winId, folderId) {
  const win = document.getElementById(winId);
  const body = win.querySelector(".win-body");
  const folder = getFolders().find(f => f.id === folderId);
  if (!folder) { body.innerHTML = '<div class="folder-empty">Folder was deleted</div>'; return; }

  const wrap = document.createElement("div");
  wrap.className = "folder-wrap";

  if (!folder.items.length) {
    wrap.innerHTML = '<div class="folder-empty">Empty — drag apps or folders here from the desktop</div>';
  } else {
    folder.items.forEach(key => {
      if (key.startsWith("folder:")) {
        const subId = key.replace("folder:", "");
        const sub = getFolders().find(f => f.id === subId);
        if (!sub) return;
        const el = buildFolderIconStatic(sub, folderId, winId);
        wrap.appendChild(el);
      } else {
        const app = findAppByKey(key);
        if (!app) return;
        const el = buildAppIconStatic(app, folderId, winId);
        wrap.appendChild(el);
      }
    });
  }
  body.innerHTML = "";
  body.appendChild(wrap);
}

// static (non-draggable, grid-flow) icons used inside folder windows
function buildAppIconStatic(app, folderId, winId) {
  const el = document.createElement("div");
  el.className = "icon";
  el.style.position = "static";
  el.innerHTML = `
    <div class="icon-glyph ${app.color || 'green'}">${escapeHtml(app.icon || initials(app.name))}</div>
    <div class="icon-label">${escapeHtml(app.name)}</div>
  `;
  const open = () => app.url === "__store__" ? openAppStore() : (app.url === "__settings__" ? openSettings() : launchApp(app));
  let lastClickTime = 0;
  el.onclick = () => {
    selectIcon(el);
    const mode = getSettings().clickMode;
    if (mode === "single") { open(); return; }
    const now = Date.now();
    if (now - lastClickTime < 350) open();
    lastClickTime = now;
  };
  el.oncontextmenu = (e) => {
    e.preventDefault();
    showAppContextMenu(e, app, folderId, winId);
  };
  return el;
}
function buildFolderIconStatic(folder, parentFolderId, winId) {
  const el = document.createElement("div");
  el.className = "icon";
  el.style.position = "static";
  el.innerHTML = `
    <div class="icon-glyph ${folder.color || 'amber'}">📁</div>
    <div class="icon-label">${escapeHtml(folder.name)}</div>
  `;
  const open = () => openFolder(folder.id);
  let lastClickTime = 0;
  el.onclick = () => {
    selectIcon(el);
    const mode = getSettings().clickMode;
    if (mode === "single") { open(); return; }
    const now = Date.now();
    if (now - lastClickTime < 350) open();
    lastClickTime = now;
  };
  el.oncontextmenu = (e) => {
    e.preventDefault();
    showFolderContextMenu(e, folder.id);
  };
  return el;
}

// ===================== SYSTEM TILES (App Store / Settings) =====================
// These two live permanently in the taskbar — never on the desktop, never
// unpinnable — rendered as distinct square glyph buttons rather than the
// usual labeled task pill.
function renderSystemTiles() {
  const wrap = document.getElementById("system-tiles");
  wrap.innerHTML = "";
  wrap.appendChild(buildSystemTile(STORE_APP, "store", storeWinId, openAppStore));
  wrap.appendChild(buildSystemTile(SETTINGS_APP, "settings", settingsWinId, openSettings));
}
function buildSystemTile(app, cls, winId, onClick) {
  const el = document.createElement("div");
  el.className = "sys-tile " + cls;
  const win = winId ? document.getElementById(winId) : null;
  const isRunning = !!win;
  const isActive = isRunning && win.classList.contains("focused") && !win.classList.contains("minimized");
  if (isRunning) el.classList.add("running");
  if (isActive) el.classList.add("active");
  el.title = app.name;
  el.textContent = app.icon;
  el.onclick = onClick;
  return el;
}

// ===================== TASKBAR PINNING =====================
// pinned = [ { name, url, icon, color } ]  — reuses the app object shape.
// Persisted independently of "installed" so an app can be pinned to the
// taskbar without being on the desktop (e.g. pinned straight from the
// Start Menu or App Store's underlying app list).
const PIN_KEY = "vusos_pinned_taskbar";
function getPinned() {
  try { return JSON.parse(localStorage.getItem(PIN_KEY)) || []; }
  catch { return []; }
}
function setPinned(list) { localStorage.setItem(PIN_KEY, JSON.stringify(list)); }
function isPinned(app) { return getPinned().some(a => appKey(a) === appKey(app)); }
function pinToTaskbar(app) {
  if (app.url === "__store__" || app.url === "__settings__") return; // not pinnable
  const list = getPinned();
  if (!list.some(a => appKey(a) === appKey(app))) {
    list.push({ name: app.name, url: app.url, icon: app.icon, color: app.color });
    setPinned(list);
  }
  renderPinnedTaskbar();
}
function unpinFromTaskbar(app) {
  setPinned(getPinned().filter(a => appKey(a) !== appKey(app)));
  renderPinnedTaskbar();
}

// Renders the pinned row of taskbar icons (apps that stay in the taskbar
// whether or not they're currently running). Running windows for a pinned
// app are represented by that SAME pinned tile — it just gains "active"
// state and the ability to be brought to front / minimized like any other
// task item, but never disappears from the taskbar when the window closes.
function renderPinnedTaskbar() {
  renderSystemTiles();
  const pinned = getPinned();
  // clear out any previously-rendered pinned tiles, then re-add in order
  tasklist.querySelectorAll('.task-item[data-pinned="1"]').forEach(el => el.remove());
  pinned.slice().reverse().forEach(app => {
    const runningId = findRunningWindowIdForApp(app);
    const el = buildTaskbarTile(app, true, runningId);
    tasklist.insertBefore(el, tasklist.firstChild);
  });
}

// Finds an already-open, non-pinned-origin window id running this exact app
// (by name+url), if any — used so a pin's tile reflects "active" state and
// can be clicked to focus/minimize the real window instead of relaunching.
function findRunningWindowIdForApp(app) {
  for (const [id, info] of openWindows.entries()) {
    if (info.app && appKey(info.app) === appKey(app) && !info.isPinnedTile) return id;
  }
  return null;
}

function buildTaskbarTile(app, pinned, runningId) {
  const el = document.createElement("div");
  el.className = "task-item" + (pinned ? " pinned" : "");
  if (pinned) el.dataset.pinned = "1";
  const isRunning = !!runningId;
  const win = isRunning ? document.getElementById(runningId) : null;
  const isActive = isRunning && win && win.classList.contains("focused") && !win.classList.contains("minimized");
  if (isActive) el.classList.add("active");
  el.innerHTML = `<span class="dot"></span><span>${escapeHtml(app.name)}</span>`;

  el.onclick = () => {
    if (runningId) {
      const w = document.getElementById(runningId);
      if (!w) { launchPinnedApp(app); return; }
      if (w.classList.contains("minimized")) {
        w.classList.remove("minimized");
        focusWindow(runningId);
      } else if (parseInt(w.style.zIndex) === zTop) {
        minimizeWindow(runningId);
      } else {
        focusWindow(runningId);
      }
    } else {
      launchPinnedApp(app);
    }
  };
  el.oncontextmenu = (e) => {
    e.preventDefault();
    showTaskbarContextMenu(e, app, pinned);
  };
  return el;
}

// Launches a pinned app's window the same way any other app launches, but
// tags the resulting window so the taskbar knows to route clicks on the
// pinned tile to this live window (see findRunningWindowIdForApp).
function launchPinnedApp(app) {
  if (!app.url.includes("raw.githubusercontent.com")) {
    window.open(app.url, "_blank", "noopener");
    return;
  }
  const id = "win" + (++winCount);
  const win = createWindow(id, app);
  desktop.appendChild(win);
  openWindows.set(id, { taskEl: null, app, isPinnedTaskbarLaunch: true });
  focusWindow(id);
  loadAppContent(id, app);
  renderPinnedTaskbar();
}

function showTaskbarContextMenu(e, app, pinned) {
  e.preventDefault();
  e.stopPropagation();
  ctxMenu.innerHTML = pinned
    ? `<div class="ctx-item danger" id="ctxUnpin">Unpin from taskbar</div>`
    : `<div class="ctx-item" id="ctxPin">Pin to taskbar</div>`;
  if (pinned) {
    ctxMenu.querySelector("#ctxUnpin").onclick = () => { unpinFromTaskbar(app); closeCtxMenu(); };
  } else {
    ctxMenu.querySelector("#ctxPin").onclick = () => { pinToTaskbar(app); closeCtxMenu(); };
  }
  const tile = e.currentTarget || e.target.closest(".task-item");
  if (tile) positionCtxNearElement(tile); else positionCtx(e);
}

// ===================== CONTEXT MENUS =====================
const ctxMenu = document.getElementById("ctxMenu");
function closeCtxMenu() { ctxMenu.classList.remove("open"); ctxMenu.innerHTML = ""; }
document.addEventListener("click", (e) => { if (!ctxMenu.contains(e.target)) closeCtxMenu(); });
document.addEventListener("scroll", closeCtxMenu, true);

function positionCtx(e) {
  ctxMenu.style.left = Math.min(e.clientX, window.innerWidth - 210) + "px";
  ctxMenu.style.top = Math.min(e.clientY, window.innerHeight - 220) + "px";
  ctxMenu.classList.add("open");
}

// Anchors the context menu to a specific element's bounding box rather than
// the raw cursor position — used for the taskbar, where positionCtx()'s
// vertical clamp (window.innerHeight - 220) can push the menu far above the
// cursor and make it feel detached from the item that was clicked.
function positionCtxNearElement(el) {
  const rect = el.getBoundingClientRect();
  ctxMenu.classList.add("open"); // add first so offsetHeight/Width are measurable
  const menuW = ctxMenu.offsetWidth || 200;
  const menuH = ctxMenu.offsetHeight || 100;
  let left = rect.left;
  if (left + menuW > window.innerWidth) left = window.innerWidth - menuW - 8;
  left = Math.max(8, left);
  // prefer opening upward from the element (taskbar sits at the bottom)
  let top = rect.top - menuH - 6;
  if (top < 8) top = rect.bottom + 6;
  ctxMenu.style.left = left + "px";
  ctxMenu.style.top = top + "px";
}

// Opens the "Sort" submenu positioned just to the right of (or, if there's
// no room, just to the left of) the "Sort" item that was clicked.
function showSortSubMenu(anchorEl) {
  const options = [
    { mode: "alpha", label: "Sort alphabetically" },
    { mode: "leftright", label: "Sort left to right" },
    { mode: "topbottom", label: "Sort top to bottom" }
  ];
  sortSubMenu.innerHTML = options.map(o =>
    `<div class="ctx-item" data-mode="${o.mode}">${o.label}</div>`
  ).join("");
  sortSubMenu.querySelectorAll(".ctx-item").forEach(el => {
    el.onclick = () => {
      sortDesktopIcons(el.dataset.mode);
      closeSortSubMenu();
      closeCtxMenu();
    };
  });

  const rect = anchorEl.getBoundingClientRect();
  const menuWidth = 200;
  let left = rect.right + 4;
  if (left + menuWidth > window.innerWidth) left = Math.max(4, rect.left - menuWidth - 4);
  let top = Math.min(rect.top, window.innerHeight - 140);
  sortSubMenu.style.left = left + "px";
  sortSubMenu.style.top = Math.max(4, top) + "px";
  sortSubMenu.classList.add("open");
}

const sortSubMenu = (() => {
  const el = document.createElement("div");
  el.className = "ctx-menu";
  el.id = "sortSubMenu";
  document.body.appendChild(el);
  return el;
})();
function closeSortSubMenu() { sortSubMenu.classList.remove("open"); sortSubMenu.innerHTML = ""; }
document.addEventListener("click", (e) => {
  if (!sortSubMenu.contains(e.target) && !(e.target.closest && e.target.closest("#ctxSort"))) closeSortSubMenu();
});

