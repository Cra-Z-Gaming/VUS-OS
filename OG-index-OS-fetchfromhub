  const linkError = body.querySelector("#bgLinkError");
  if (bg.link) {
    linkPreview.style.backgroundImage = `url("${bg.link}")`;
    linkPreview.classList.add("show");
  }
  function applyLink() {
    const url = linkInput.value.trim();
    linkError.classList.remove("show");
    if (!url) return;
    // validate the image actually loads before committing it as the background
    const testImg = new Image();
    testImg.onload = () => {
      linkPreview.style.backgroundImage = `url("${url}")`;
      linkPreview.classList.add("show");
      setBackground({ mode: "link", link: url });
      setActiveMode("link");
    };
    testImg.onerror = () => {
      linkError.classList.add("show");
    };
    testImg.src = url;
  }
  linkApply.onclick = applyLink;
  linkInput.addEventListener("keydown", (e) => { if (e.key === "Enter") applyLink(); });
}

function createWindow(id, app, isStore) {
  const win = document.createElement("div");
  win.className = "win focused";
  win.id = id;
  win.dataset.title = app.name;

  // staggered default position/size
  const offset = (winCount % 8) * 26;
  const w = Math.min(760, window.innerWidth - 100);
  const h = Math.min(520, window.innerHeight - 160);
  win.style.width = w + "px";
  win.style.height = h + "px";
  win.style.left = (60 + offset) + "px";
  win.style.top = (40 + offset) + "px";
  win.style.zIndex = ++zTop;

  win.innerHTML = `
    <div class="win-titlebar">
      <div class="win-icon icon-glyph ${app.color || 'green'}">${escapeHtml(app.icon || initials(app.name))}</div>
      <div class="win-title">${escapeHtml(app.name)}</div>
      <button class="win-btn min" title="Minimize">&#8212;</button>
      <button class="win-btn max" title="Maximize">&#9723;</button>
      <button class="win-btn close" title="Close">&#10005;</button>
    </div>
    <div class="win-body">
      ${isStore ? '' : `<div class="win-loading">Loading ${escapeHtml(app.name)}...</div>`}
    </div>
    <div class="win-resize"></div>
  `;

  // focus on any interaction
  win.addEventListener("mousedown", () => focusWindow(id), true);

  // dragging
  const titlebar = win.querySelector(".win-titlebar");
  titlebar.addEventListener("mousedown", (e) => {
    if (e.target.closest(".win-btn")) return;
    if (win.classList.contains("maximized")) return;
    const startX = e.clientX, startY = e.clientY;
    const startLeft = win.offsetLeft, startTop = win.offsetTop;
    function onMove(ev) {
      win.style.left = (startLeft + ev.clientX - startX) + "px";
      win.style.top = Math.max(0, startTop + ev.clientY - startY) + "px";
    }
    function onUp() {
      document.removeEventListener("mousemove", onMove);
      document.removeEventListener("mouseup", onUp);
    }
    document.addEventListener("mousemove", onMove);
    document.addEventListener("mouseup", onUp);
  });
  titlebar.addEventListener("dblclick", (e) => {
    if (e.target.closest(".win-btn")) return;
    toggleMaximize(id);
  });

  // resizing
  const resizer = win.querySelector(".win-resize");
  resizer.addEventListener("mousedown", (e) => {
    e.stopPropagation();
    const startX = e.clientX, startY = e.clientY;
    const startW = win.offsetWidth, startH = win.offsetHeight;
    function onMove(ev) {
      win.style.width = Math.max(320, startW + ev.clientX - startX) + "px";
      win.style.height = Math.max(220, startH + ev.clientY - startY) + "px";
    }
    function onUp() {
      document.removeEventListener("mousemove", onMove);
      document.removeEventListener("mouseup", onUp);
    }
    document.addEventListener("mousemove", onMove);
    document.addEventListener("mouseup", onUp);
  });

  win.querySelector(".win-btn.min").onclick = () => minimizeWindow(id);
  win.querySelector(".win-btn.max").onclick = () => toggleMaximize(id);
  win.querySelector(".win-btn.close").onclick = () => closeWindow(id);

  return win;
}

function loadAppContent(id, app) {
  const win = document.getElementById(id);
  const body = win.querySelector(".win-body");
  fetch(app.url)
    .then(r => {
      if (!r.ok) throw new Error("HTTP " + r.status);
      return r.text();
    })
    .then(text => {
      const iframe = document.createElement("iframe");
      // start on a blank, same-origin document so document.write() below
      // runs in a normal (non-CSP-sandboxed) context — GitHub's raw file
      // responses carry a "CSP: sandbox" header that blocks scripts when
      // the raw HTML is loaded via a blob: URL, so we write the fetched
      // text directly into the iframe's own document instead.
      iframe.src = "about:blank";
      body.innerHTML = "";
      body.appendChild(iframe);
      const doc = iframe.contentDocument || iframe.contentWindow.document;
      doc.open();
      doc.write(text);
      doc.close();
    })
    .catch(() => {
      body.innerHTML = `<div class="win-loading" style="color:var(--danger)">Failed to load ${escapeHtml(app.name)}</div>`;
    });
}

function createTaskItem(id, app) {
  const el = document.createElement("div");
  el.className = "task-item active";
  el.innerHTML = `<span class="dot"></span><span>${escapeHtml(app.name)}</span>`;
  el.onclick = () => {
    const win = document.getElementById(id);
    if (win.classList.contains("minimized")) {
      win.classList.remove("minimized");
      focusWindow(id);
    } else if (parseInt(win.style.zIndex) === zTop) {
      minimizeWindow(id);
    } else {
      focusWindow(id);
    }
  };
  el.oncontextmenu = (e) => {
    e.preventDefault();
    e.stopPropagation();
    // allow pinning straight from a running (unpinned) window's task item
    if (app.url === "__store__" || app.url === "__settings__") return;
    showTaskbarContextMenu(e, app, isPinned(app));
  };
  tasklist.appendChild(el);
  openWindows.set(id, { el: document.getElementById.bind(document), taskEl: el, app });
}

function focusWindow(id) {
  document.querySelectorAll(".win").forEach(w => w.classList.remove("focused"));
  document.querySelectorAll(".task-item").forEach(t => t.classList.remove("active"));
  const win = document.getElementById(id);
  if (!win) return;
  win.classList.add("focused");
  win.style.zIndex = ++zTop;
  const info = openWindows.get(id);
  if (info && info.taskEl) info.taskEl.classList.add("active");
  // re-render pinned tiles so the correct pinned tile lights up as active
  // when the focused window belongs to a pinned app
  renderPinnedTaskbar();
}

function minimizeWindow(id) {
  const win = document.getElementById(id);
  win.classList.add("minimized");
  const info = openWindows.get(id);
  if (info && info.taskEl) info.taskEl.classList.remove("active");
  renderPinnedTaskbar();
}

function toggleMaximize(id) {
  const win = document.getElementById(id);
  win.classList.toggle("maximized");
}

function closeWindow(id) {
  const win = document.getElementById(id);
  win.remove();
  const info = openWindows.get(id);
  if (info && info.taskEl) info.taskEl.remove();
  openWindows.delete(id);
  if (id === storeWinId) storeWinId = null;
  if (id === settingsWinId) settingsWinId = null;
  // if the closed window belonged to a pinned app, its pinned tile should
  // drop back to non-running/inactive state rather than being removed
  renderPinnedTaskbar();
}

// ===================== CLOCK =====================
function updateClock() {
  const now = new Date();
  document.getElementById("clockTime").textContent =
    now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
  document.getElementById("clockDate").textContent =
    now.toLocaleDateString([], { month: "short", day: "numeric" });
}
setInterval(updateClock, 1000 * 15);
updateClock();
</script>
