<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VUS-OS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0e1a;
    --bg-elevated: #111827;
    --card: rgba(17, 24, 39, 0.7);
    --card-hover: rgba(30, 41, 59, 0.8);
    --border: rgba(51, 65, 85, 0.5);
    --border-hover: rgba(74, 222, 128, 0.35);
    --fg: #f1f5f9;
    --fg-muted: #94a3b8;
    --fg-dim: #475569;
    --accent: #22c55e;
    --accent-glow: rgba(34, 197, 94, 0.15);
    --danger: #ef4444;
    --radius: 12px;
    --font: 'Space Grotesk', sans-serif;
    --mono: 'JetBrains Mono', monospace;
    --taskbar-h: 56px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 100%; height: 100%;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    user-select: none;
  }

  /* ================= BOOT SCREEN ================= */
  #boot {
    position: fixed; inset: 0;
    z-index: 1000;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    transition: opacity 0.5s ease;
  }
  #boot.hide { opacity: 0; pointer-events: none; }

  .boot-logo {
    width: 72px; height: 72px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--accent), #10b981);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 32px; color: #000;
    box-shadow: 0 0 40px rgba(34,197,94,0.35);
    animation: bootPulse 1.6s ease-in-out infinite;
  }
  @keyframes bootPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.06); }
  }

  .boot-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--fg-muted);
  }

  .boot-bar-track {
    width: 260px;
    height: 6px;
    border-radius: 4px;
    background: var(--card);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .boot-bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--accent), #10b981);
    box-shadow: 0 0 12px rgba(34,197,94,0.5);
    transition: width 2s linear;
  }

  /* ================= DESKTOP ================= */
  #desktop {
    position: fixed;
    inset: 0;
    bottom: var(--taskbar-h);
    background:
      radial-gradient(circle at 15% 15%, rgba(34,197,94,0.10), transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(16,185,129,0.08), transparent 45%),
      var(--bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  #icons {
    position: absolute;
    inset: 0;
    padding: 14px;
  }

  .icon {
    position: absolute;
    width: var(--icon-cell, 84px);
    height: var(--icon-cell-h, 88px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    padding: 8px 4px;
    border-radius: 6px;
    cursor: pointer;
    text-align: center;
  }
  .icon.dragging { opacity: 0.4; }

  #grid-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.15s;
    background-image:
      linear-gradient(to right, rgba(34,197,94,0.18) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(34,197,94,0.18) 1px, transparent 1px);
  }
  #grid-overlay.show { opacity: 1; }
  .icon:hover, .icon.selected {
    background: rgba(255,255,255,0.06);
    outline: 1px solid var(--border-hover);
  }
  .icon-glyph {
    width: 42px; height: 42px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; font-weight: 700;
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
    flex-shrink: 0;
  }
  /* desktop icons scale their glyph with the chosen icon size */
  .icon .icon-glyph {
    width: var(--icon-glyph, 42px);
    height: var(--icon-glyph, 42px);
    font-size: var(--icon-glyph-font, 17px);
    border-radius: calc(var(--icon-glyph, 42px) * 0.24);
  }
  .icon-glyph.green { background: rgba(34,197,94,0.18); color: #4ade80; }
  .icon-glyph.blue { background: rgba(59,130,246,0.18); color: #60a5fa; }
  .icon-glyph.amber { background: rgba(245,158,11,0.18); color: #fbbf24; }
  .icon-glyph.rose { background: rgba(244,63,94,0.18); color: #fb7185; }
  .icon-glyph.violet { background: rgba(139,92,246,0.18); color: #a78bfa; }
  .icon-glyph.cyan { background: rgba(6,182,212,0.18); color: #22d3ee; }
  .icon-glyph.lime { background: rgba(132,204,22,0.18); color: #a3e635; }
  .icon-glyph.orange { background: rgba(249,115,22,0.18); color: #fb923c; }
  .icon-glyph.red { background: rgba(239,68,68,0.18); color: #f87171; }
  .icon-glyph.black { background: rgba(148,163,184,0.18); color: #cbd5e1; }
  .icon-glyph.white { background: rgba(255,255,255,0.14); color: #f1f5f9; }

  .icon-label {
    font-size: 11.5px;
    line-height: 1.25;
    color: var(--fg);
    text-shadow: 0 1px 3px rgba(0,0,0,0.6);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  /* ================= WINDOWS ================= */
  .win {
    position: absolute;
    min-width: 320px;
    min-height: 220px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .win.focused {
    border-color: var(--border-hover);
    box-shadow: 0 24px 70px rgba(0,0,0,0.6), 0 0 0 1px rgba(34,197,94,0.15);
  }
  .win.minimized { display: none; }
  .win.maximized {
    top: 0 !important; left: 0 !important;
    width: 100% !important; height: 100% !important;
    border-radius: 0;
  }

  .win-titlebar {
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 8px 0 14px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    cursor: grab;
  }
  .win-titlebar:active { cursor: grabbing; }

  .win-icon {
    width: 22px; height: 22px;
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 700;
    flex-shrink: 0;
  }

  .win-title {
    flex: 1;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .win-btn {
    width: 30px; height: 30px;
    border-radius: 7px;
    border: none;
    background: transparent;
    color: var(--fg-muted);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    font-family: var(--font);
    font-size: 15px;
  }
  .win-btn:hover { background: rgba(255,255,255,0.08); color: var(--fg); }
  .win-btn.close:hover { background: var(--danger); color: #fff; }

  .win-body {
    flex: 1;
    position: relative;
    background: #000;
    overflow: hidden;
    min-height: 0;
  }
  .win-body iframe {
    width: 100%; height: 100%;
    border: none;
    display: block;
  }
  .win-body .win-loading {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    color: var(--fg-dim);
    font-size: 13px;
    font-family: var(--mono);
    background: var(--bg-elevated);
  }

  .win-resize {
    position: absolute;
    right: 0; bottom: 0;
    width: 16px; height: 16px;
    cursor: nwse-resize;
    z-index: 2;
  }
  .win-resize::after {
    content: '';
    position: absolute;
    right: 4px; bottom: 4px;
    width: 8px; height: 8px;
    border-right: 2px solid var(--fg-dim);
    border-bottom: 2px solid var(--fg-dim);
  }

  /* ================= TASKBAR ================= */
  #taskbar {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    height: var(--taskbar-h);
    background: rgba(17,24,39,0.85);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    z-index: 500;
  }

  #start-btn {
    display: flex; align-items: center; gap: 8px;
    height: 40px;
    padding: 0 14px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg);
    font-family: var(--font);
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    flex-shrink: 0;
  }
  #start-btn:hover { border-color: var(--border-hover); background: var(--card-hover); }
  #start-btn .mark {
    width: 22px; height: 22px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--accent), #10b981);
    color: #000;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700;
  }

  #taskbar-sep {
    width: 1px; height: 28px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* system tiles (App Store / Settings) — permanently pinned, visually
     distinct from ordinary app tiles: square glyph-style buttons rather
     than a labeled pill, tinted with their own accent color at rest. */
  #system-tiles {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
    padding-right: 2px;
  }
  .sys-tile {
    width: 40px; height: 40px;
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    cursor: pointer;
    border: 1px solid transparent;
    position: relative;
    flex-shrink: 0;
  }
  .sys-tile.store {
    background: rgba(139,92,246,0.14);
    color: #a78bfa;
  }
  .sys-tile.store:hover { background: rgba(139,92,246,0.22); }
  .sys-tile.store.active {
    border-color: rgba(139,92,246,0.5);
    background: rgba(139,92,246,0.26);
    box-shadow: 0 0 0 1px rgba(139,92,246,0.15);
  }
  .sys-tile.settings {
    background: rgba(6,182,212,0.14);
    color: #22d3ee;
  }
  .sys-tile.settings:hover { background: rgba(6,182,212,0.22); }
  .sys-tile.settings.active {
    border-color: rgba(6,182,212,0.5);
    background: rgba(6,182,212,0.26);
    box-shadow: 0 0 0 1px rgba(6,182,212,0.15);
  }
  .sys-tile.running::after {
    content: '';
    position: absolute;
    bottom: 3px; left: 50%;
    transform: translateX(-50%);
    width: 4px; height: 4px;
    border-radius: 50%;
    background: currentColor;
  }

  #tasklist {
    flex: 1;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    height: 100%;
    align-items: center;
    scrollbar-width: none;
  }
  #tasklist::-webkit-scrollbar { display: none; }

  .task-item {
    display: flex; align-items: center; gap: 8px;
    height: 38px;
    padding: 0 12px;
    border-radius: 8px;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    max-width: 180px;
    flex-shrink: 0;
  }
  .task-item span {
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .task-item .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--fg-dim);
    flex-shrink: 0;
  }
  .task-item.active {
    border-color: var(--border-hover);
    color: var(--fg);
    background: var(--card-hover);
  }
  .task-item.active .dot { background: var(--accent); box-shadow: 0 0 6px rgba(34,197,94,0.6); }
  .task-item.pinned .dot { background: var(--fg-dim); }
  .task-item.pinned.active .dot { background: var(--accent); box-shadow: 0 0 6px rgba(34,197,94,0.6); }
  .task-item .pin-mark {
    font-size: 9px;
    color: var(--fg-dim);
    flex-shrink: 0;
  }

  #clock {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-muted);
    padding: 0 12px;
    flex-shrink: 0;
    text-align: right;
    line-height: 1.3;
  }
  #clock .date { font-size: 10.5px; color: var(--fg-dim); }

  /* ================= START MENU ================= */
  #start-menu {
    position: fixed;
    left: 10px;
    bottom: calc(var(--taskbar-h) + 8px);
    width: 340px;
    max-height: 60vh;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.5);
    z-index: 600;
    display: none;
    flex-direction: column;
    overflow: hidden;
  }
  #start-menu.open { display: flex; }

  .start-search {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .start-search input {
    width: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 9px 12px;
    color: var(--fg);
    font-family: var(--font);
    font-size: 13px;
    outline: none;
  }
  .start-search input:focus { border-color: var(--accent); }

  .start-list {
    overflow-y: auto;
    padding: 8px;
  }
  .start-item {
    display: flex; align-items: center; gap: 12px;
    padding: 9px 10px;
    border-radius: 8px;
    cursor: pointer;
  }
  .start-item:hover { background: rgba(255,255,255,0.06); }
  .start-item-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700;
    flex-shrink: 0;
  }
  .start-item-text { flex: 1; overflow: hidden; }
  .start-item-name { font-size: 13px; font-weight: 600; color: var(--fg); }
  .start-item-desc {
    font-size: 11px; color: var(--fg-dim);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* ================= SETTINGS APP ================= */
  .settings-wrap {
    height: 100%;
    overflow-y: auto;
    padding: 20px 24px;
    background: var(--bg-elevated);
    font-family: var(--font);
  }
  .settings-wrap h2 { font-size: 18px; font-weight: 700; margin-bottom: 18px; }
  .settings-section-title {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin: 22px 0 4px;
  }
  .settings-section-title:first-of-type { margin-top: 4px; }
  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .settings-row:last-child { border-bottom: none; }
  .settings-row-label { font-size: 13.5px; font-weight: 600; color: var(--fg); }
  .settings-row-desc { font-size: 11.5px; color: var(--fg-dim); margin-top: 2px; }
  .settings-toggle {
    width: 42px; height: 24px;
    border-radius: 12px;
    background: var(--card);
    border: 1px solid var(--border);
    position: relative;
    cursor: pointer;
    flex-shrink: 0;
  }
  .settings-toggle.on { background: var(--accent); border-color: var(--accent); }
  .settings-toggle-dot {
    position: absolute;
    top: 2px; left: 2px;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: #fff;
    transition: left 0.15s;
  }
  .settings-toggle.on .settings-toggle-dot { left: 20px; }
  .settings-select {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 7px 10px;
    color: var(--fg);
    font-family: var(--font);
    font-size: 12.5px;
    outline: none;
    flex-shrink: 0;
  }
  .settings-input {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 8px 10px;
    color: var(--fg);
    font-family: var(--font);
    font-size: 12.5px;
    outline: none;
    flex-shrink: 0;
    width: 200px;
  }
  .settings-input:focus { border-color: var(--accent); }

  /* background mode picker */
  .bg-mode-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .bg-mode-btn {
    flex: 1;
    min-width: 76px;
    padding: 9px 6px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg-muted);
    font-family: var(--font);
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
  }
  .bg-mode-btn:hover { border-color: var(--border-hover); color: var(--fg); }
  .bg-mode-btn.active {
    background: var(--accent-glow);
    border-color: rgba(34,197,94,0.4);
    color: var(--accent);
  }
  .bg-panel {
    margin-top: 14px;
    padding: 14px;
    border-radius: 10px;
    background: var(--card);
    border: 1px solid var(--border);
    display: none;
  }
  .bg-panel.show { display: block; }
  .bg-color-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bg-color-swatch-wrap {
    position: relative;
    width: 52px; height: 52px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
    flex-shrink: 0;
  }
  .bg-color-swatch-wrap input[type="color"] {
    position: absolute;
    top: -8px; left: -8px;
    width: 68px; height: 68px;
    border: none;
    padding: 0;
    cursor: pointer;
    background: none;
  }
  .bg-color-swatch-wrap input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
  .bg-color-swatch-wrap input[type="color"]::-webkit-color-swatch { border: none; }
  .bg-color-hex {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-muted);
    flex: 1;
  }
  .bg-color-presets {
    display: flex;
    gap: 6px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .bg-color-preset {
    width: 24px; height: 24px;
    border-radius: 7px;
    cursor: pointer;
    border: 2px solid transparent;
    flex-shrink: 0;
  }
  .bg-color-preset:hover { border-color: var(--fg-muted); }
  .bg-color-preset.active { border-color: var(--fg); }
  .bg-upload-zone {
    border: 1.5px dashed var(--border);
    border-radius: 10px;
    padding: 22px 14px;
    text-align: center;
    cursor: pointer;
  }
  .bg-upload-zone:hover { border-color: var(--border-hover); background: rgba(255,255,255,0.03); }
  .bg-upload-zone .bg-upload-icon { font-size: 22px; margin-bottom: 6px; }
  .bg-upload-zone .bg-upload-text { font-size: 12.5px; color: var(--fg-muted); }
  .bg-upload-zone .bg-upload-sub { font-size: 10.5px; color: var(--fg-dim); margin-top: 3px; }
  .bg-preview {
    margin-top: 12px;
    width: 100%;
    height: 90px;
    border-radius: 8px;
    background-size: cover;
    background-position: center;
    border: 1px solid var(--border);
    display: none;
  }
  .bg-preview.show { display: block; }
  .bg-link-row { display: flex; gap: 8px; }
  .bg-link-row input { flex: 1; }
  .bg-apply-btn {
    margin-top: 4px;
    padding: 8px 14px;
    border-radius: 7px;
    border: 1px solid rgba(34,197,94,0.4);
    background: var(--accent-glow);
    color: var(--accent);
    font-family: var(--font);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
  .bg-apply-btn:hover { background: rgba(34,197,94,0.25); }
  .bg-error {
    font-size: 11px;
    color: var(--danger);
    margin-top: 6px;
    display: none;
  }
  .bg-error.show { display: block; }

  .store-wrap {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    color: var(--fg);
    font-family: var(--font);
    min-height: 0;
  }
  .store-header {
    padding: 16px 20px 12px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .store-header h2 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .store-search {
    width: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 9px 12px;
    color: var(--fg);
    font-family: var(--font);
    font-size: 13px;
    outline: none;
  }
  .store-search:focus { border-color: var(--accent); }
  .store-tabs {
    display: flex;
    gap: 6px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .store-tab {
    font-size: 12px;
    font-weight: 600;
